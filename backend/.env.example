NODE_ENV=development
PORT=8080

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=bizai
DATABASE_USER=root
DATABASE_PASSWORD=

JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

APP_URL=http://localhost:8080
FLUTTER_ANDROID_PACKAGE=com.bizai.app

AI_DEFAULT_PROVIDER=GEMINI
AI_DEFAULT_MODEL=

GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
HUGGINGFACE_ENDPOINT=

WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=BizAI
EMAIL_FROM_ADDRESS=noreply@bizai.app

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
